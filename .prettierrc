{
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"singleQuote": true,
	"bracketSameLine": false,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "always",
	"semi": true,
	"endOfLine": "lf",
	"quoteProps": "as-needed",
	"overrides": [
		{
			"files": ["frontend/src/routes/index.jsx", "frontend/src/routes/LmsRoutes.jsx"],
			"options": { "printWidth": 400 }
		}
	]
}
