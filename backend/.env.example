APP_NAME=KampusX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kampusx
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@kampusx.id"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# PAYMENT GATEWAY CONFIGURATION
# ==========================================
PAYMENT_PROVIDER=duitku
PAYMENT_MODE=sandbox
PAYMENT_HOLD_MINUTES=15

# Duitku Credentials (https://merchant.duitku.com/)
DUITKU_MERCHANT_CODE=your_merchant_code_here
DUITKU_API_KEY=your_sandbox_api_key_here
DUITKU_CALLBACK_URL=https://your-ngrok-domain.ngrok-free.app/api/payment/callback/duitku
DUITKU_RETURN_URL=http://localhost:5173/checkout/result
